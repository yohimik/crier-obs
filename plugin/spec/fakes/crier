#!/bin/sh
if [ -n "$FAKE_CRIER_OUT" ]; then
  mkdir -p "$FAKE_CRIER_OUT"
  printf '%s\n' "$@" >"$FAKE_CRIER_OUT/argv"
  env >"$FAKE_CRIER_OUT/env"
  pwd >"$FAKE_CRIER_OUT/cwd"
  ls /dev/fd >"$FAKE_CRIER_OUT/fds"
fi
if [ "${FAKE_CRIER_READ:-}" = 1 ]; then cat; fi
if [ "$FAKE_CRIER_IGNORE_TERM" = 1 ]; then trap '' TERM; fi
if [ -n "$FAKE_CRIER_SLEEP" ]; then sleep "$FAKE_CRIER_SLEEP"; fi
case "$*" in
  *--version*) printf '{"version":"%s"}\n' "${FAKE_CRIER_VERSION:-1.1.1}" ;;
  *platforms*) printf '{"platforms":["telegram","discord"]}\n' ;;
  *ping*) printf '[{"target":"telegram","ok":true,"account":"fake","ms":1}]\n' ;;
  *) printf '{"results":[{"platform":"telegram","ok":true}]}\n' ;;
esac
if [ -n "$FAKE_CRIER_LEAK" ]; then printf '%s\n' "$FAKE_CRIER_LEAK" >&2; fi
exit "${FAKE_CRIER_EXIT:-0}"
